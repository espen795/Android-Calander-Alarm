# Copy this to gradle.properties and fill in your own values
# NEVER commit gradle.properties to git!

org.gradle.jvmargs=-Xmx4096m -Dfile.encoding=UTF-8
org.gradle.parallel=true
org.gradle.caching=true
org.gradle.configuration-cache=true
android.useAndroidX=true
kotlin.code.style=official
android.nonTransitiveRClass=true

# Keystore configuration - use environment variables or local gradle.properties
# KEYSTORE_PATH=/path/to/keystore.jks
# KEYSTORE_PASSWORD=your_secure_password
# KEY_ALIAS=your_alias
# KEY_PASSWORD=your_secure_password
