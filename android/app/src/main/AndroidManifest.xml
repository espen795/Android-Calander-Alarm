<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- SCHEDULE_EXACT_ALARM: required for AlarmManager.setAlarmClock on Android 12+ -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- Network for HTTPS pull sync + update downloads -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Notifications (Android 13+ runtime permission) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Boot & package-replaced restart for alarm re-arming -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Vibrate + wake lock for alarm ringing -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- v2.5.7 Story 2: Battery optimization — allow requesting exemption for reliable alarm sync -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- v2.5.3: Full-screen intent for timer ringing activity (Android 14+) -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!-- v2.6.9: SYSTEM_ALERT_WINDOW ("Appear on top") — Samsung One UI requires this for overlay activities -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- v2.5.6: Foreground service for timer (Samsung OOM killer protection) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!-- Install packages (for self-update) -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".CalendarAlarmApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CalendarAlarm"
        android:networkSecurityConfig="@xml/network_security_config"
        tools:targetApi="35">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.CalendarAlarm">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- v2.6.10: Simplified for lockscreen compatibility (GPT Sol analysis) -->
        <!-- Removed: singleInstance, taskAffinity, showForAllUsers — A/B test -->
        <!-- v2.6.13 H2: configChanges prevents rotation/dark-mode/font-change from destroying the activity
             (onDestroy previously stopped the alarm silently). Back gesture is intercepted
             via OnBackPressedCallback (back = snooze or dismiss). -->
        <activity
            android:name=".ui.AlarmRingingActivity"
            android:exported="false"
            android:launchMode="standard"
            android:excludeFromRecents="true"
            android:showOnLockScreen="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:configChanges="orientation|screenSize|uiMode|keyboardHidden|screenLayout|smallestScreenSize|density|fontScale"
            android:theme="@style/Theme.CalendarAlarm" />

        <!-- v2.6.10: Timer activity also simplified -->
        <activity
            android:name=".ui.TimerRingingActivity"
            android:exported="false"
            android:launchMode="standard"
            android:excludeFromRecents="true"
            android:showOnLockScreen="true"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@style/Theme.CalendarAlarm" />

        <!-- v2.3.0: Widget debug activity (development/testing only) -->
        <activity
            android:name=".ui.WidgetDebugActivity"
            android:exported="false"
            android:label="Widget Debug"
            android:theme="@style/Theme.CalendarAlarm">
            <intent-filter>
                <action android:name="io.github.calendaralarm.WIDGET_DEBUG" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Alarm receiver (fires alarms, handles snooze/dismiss) -->
        <receiver
            android:name=".receiver.OwnedAlarmReceiver"
            android:enabled="true"
            android:exported="false" />

        <!-- F4: Pre-alarm receiver (shows notification 60 min before alarm, handles turn-off/skip actions) -->
        <receiver
            android:name=".receiver.PreAlarmReceiver"
            android:enabled="true"
            android:exported="false" />

        <!-- v2.5.3: Timer action receiver (handles Stop action from timer notification) -->
        <receiver
            android:name=".receiver.TimerActionReceiver"
            android:enabled="true"
            android:exported="false" />

        <!-- v2.5.6 Story 3: Timer fire receiver (fires when countdown timer completes) -->
        <receiver
            android:name=".receiver.TimerFireReceiver"
            android:enabled="true"
            android:exported="false" />

        <!-- v2.5.6 Story 6: Timer foreground service (keeps app alive while timer runs) -->
        <service
            android:name=".service.TimerForegroundService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- v2.5.7: Alarm foreground service (Samsung OOM killer protection for alarm sound) -->
        <service
            android:name=".service.AlarmForegroundService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- Boot & package-replaced receiver for alarm re-arming -->
        <receiver
            android:name=".service.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- FileProvider for APK install -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- v2.3.0: Home screen widget (semi-transparent: time + date + next alarm) -->
        <receiver
            android:name=".receiver.AlarmWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/alarm_widget_info" />
        </receiver>

    </application>

</manifest>
