# Copy to .env (never commit .env)
# Long random device token shared with the app: python3 -c "import secrets;print(secrets.token_hex(32))"
CALALARM_DEVICE_TOKEN=
# Public hostname Traefik routes to this API
CALALARM_API_HOST=alarm-api.example.com
# Optional read-only token for monitoring GET /api/heartbeat/status (cannot post or read config)
CALALARM_MONITOR_TOKEN=
# IP of your reverse proxy on the docker 'proxy' network (docker network inspect proxy)
FORWARDED_ALLOW_IPS=172.18.0.2
